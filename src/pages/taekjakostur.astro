---
import Base from '../layouts/Base.astro';
import { reader, resolveImg } from '../lib/content';
import { eyebrows, equipmentTabs } from '../data/site';

const equipment = await reader.singletons.equipment.read();
if (!equipment) throw new Error('Vantar efni fyrir "Tækjakostur" (src/content/equipment)');

type Machine = {
  image: string | null;
  title: string;
  sub: string;
  stats?: readonly { value: string; label: string }[];
};

// Gröfur and Önnur tæki are small cards in 3 columns; trucks and haulers are wider, in 2.
const layout: Record<string, { cols: number; imgH: number }> = {
  grofur: { cols: 3, imgH: 220 },
  vorubilar: { cols: 2, imgH: 280 },
  bukollur: { cols: 2, imgH: 280 },
  onnur: { cols: 3, imgH: 220 },
};

// Tabs with no machines are left out.
const tabs = equipmentTabs
  .map((t) => ({ ...t, items: (equipment[t.key as keyof typeof equipment] ?? []) as readonly Machine[] }))
  .filter((t) => t.items.length > 0);
---

<Base title="Tækjakostur — Þ.S. Verktakar ehf.">
  <div class="wrap wrap-top" style="max-width:1180px;margin:0 auto;padding:150px 40px 40px">
    <div data-reveal style="font:700 13px 'Space Mono',monospace;color:#3778c2;letter-spacing:.24em;margin-bottom:14px">
      {eyebrows.equipment}
    </div>
    <h1 data-reveal style="margin:0 0 32px;font:900 clamp(44px,7vw,88px)/0.95 'Archivo',sans-serif">
      Búnaður fyrir hvert verk
    </h1>

    <!-- tab bar -->
    <div data-reveal role="tablist" aria-label="Tegund tækja" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:40px">
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${t.key}`}
            aria-controls={`panel-${t.key}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-taeki={t.key}
            style="font:700 13px 'Barlow Condensed',sans-serif;letter-spacing:.12em;text-transform:uppercase;padding:14px 22px;color:#eef1f4;border-radius:3px;cursor:pointer"
          >
            {t.label}
          </button>
        ))
      }
    </div>

    {
      tabs.map((t, i) => {
        const { cols, imgH } = layout[t.key] ?? { cols: 3, imgH: 220 };
        const pad = cols === 2 ? 24 : 22;
        return (
          <div
            data-taeki-panel={t.key}
            role="tabpanel"
            id={`panel-${t.key}`}
            aria-labelledby={`tab-${t.key}`}
            hidden={i !== 0}
          >
            <div style={`display:grid;grid-template-columns:repeat(${cols},minmax(0,1fr));gap:20px`}>
              {t.items.map((m) => (
                <div class="fleet-card" data-reveal>
                  {m.image ? (
                    <div style={`height:${imgH}px;background:url('${resolveImg(m.image)}') center/cover no-repeat`} />
                  ) : (
                    <div class="img-placeholder" style={`height:${imgH}px`}>
                      [ mynd væntanleg ]
                    </div>
                  )}
                  <div style={`padding:${pad}px`}>
                    <div style={`font:800 ${cols === 2 ? 24 : 22}px 'Archivo',sans-serif;overflow-wrap:anywhere`}>{m.title}</div>
                    {m.sub && (
                      <div style="font:400 15px 'IBM Plex Sans',sans-serif;color:#9aa2ab;margin-top:4px">{m.sub}</div>
                    )}
                    {m.stats && m.stats.length > 0 && (
                      <div style="display:flex;flex-wrap:wrap;gap:12px 24px;margin-top:16px;padding-top:16px;border-top:1px solid rgba(238,241,244,.1)">
                        {m.stats.map((st) => (
                          <div>
                            <div style="font:800 20px 'Archivo',sans-serif;color:#6fa0dc;white-space:nowrap">{st.value}</div>
                            <div style="font:400 12px 'IBM Plex Sans',sans-serif;color:#7d848d">{st.label}</div>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</Base>
